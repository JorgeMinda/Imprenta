datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Auth (Wasp + Supabase) ──────────────────────────────────────────

model Auth {
  id           String    @id @default(uuid())
  email        String?   @unique
  username     String?   @unique
  password     String?
  userId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresIn Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── App Models ───────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  CONTADOR
  LECTOR
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(CONTADOR)
  createdAt DateTime @default(now())
  auth      Auth?
  sessions  Session[]
}

enum AccountType {
  ACTIVO
  PASIVO
  PATRIMONIO
  INGRESO
  GASTO
  COSTOS
}

enum NaturalSign {
  DEUDORA
  ACREEDORA
}

enum EntryStatus {
  POSTED
  REVERSED
}

enum SourceType {
  FACTURA_VENTA
  FACTURA_COMPRA
  RETENCION
  NOTA_CREDITO
  NOTA_DEBITO
  DIARIO_GENERAL
  AJUSTE
}

model Account {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  type        AccountType
  naturalSign NaturalSign
  parentId    String?      @map("parent_id")
  isDetail    Boolean      @default(true)
  active      Boolean      @default(true)
  parent      Account?     @relation("AccountTree", fields: [parentId], references: [id])
  children    Account[]    @relation("AccountTree")
  lines       JournalLine[]

  @@index([parentId])
  @@map("accounts")
}

model FiscalPeriod {
  id        String         @id @default(uuid())
  label     String
  startDate DateTime       @map("start_date")
  endDate   DateTime       @map("end_date")
  closed    Boolean        @default(false)
  entries   JournalEntry[]

  @@map("fiscal_periods")
}

model JournalEntry {
  id         String       @id @default(uuid())
  date       DateTime     @db.Date
  concept    String
  reference  String?
  sourceType SourceType
  periodId   String       @map("period_id")
  status     EntryStatus  @default(POSTED)
  createdBy  String       @map("created_by")
  createdAt  DateTime     @default(now())
  period     FiscalPeriod @relation(fields: [periodId], references: [id])
  lines      JournalLine[]

  @@index([date])
  @@index([periodId])
  @@map("journal_entries")
}

model JournalLine {
  id          String       @id @default(uuid())
  entryId     String       @map("entry_id")
  accountId   String       @map("account_id")
  debitCents  BigInt       @map("debit_cents")
  creditCents BigInt       @map("credit_cents")
  description String?
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([entryId])
  @@map("journal_lines")
}
